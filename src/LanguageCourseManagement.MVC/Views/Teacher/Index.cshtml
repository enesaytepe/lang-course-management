@model LanguageCourseManagement.MVC.Models.ViewModels.TeacherFormViewModel
@{
    ViewData["Title"] = "Öğretmenler";
    var isSystemAdmin = User.IsInRole("SystemAdmin");
}

<section class="content-card" id="teachers-page" data-can-edit="@(isSystemAdmin.ToString().ToLowerInvariant())">
    <div class="section-heading">
        <div>
            <h1>Öğretmenler</h1>
            <p>Öğretmen yönetimi</p>
        </div>
        @if (isSystemAdmin)
        {
            <a class="btn btn-primary" asp-action="Create">Yeni öğretmen</a>
        }
    </div>

    <div class="table-responsive">
        <table class="table" id="teachersTable" data-datatable>
            <caption class="visually-hidden">Öğretmen listesi</caption>
            <thead>
                <tr>
                    <th scope="col">Ad Soyad</th>
                    <th scope="col">Cep Telefonu</th>
                    <th scope="col">İşe Başlama</th>
                    <th scope="col">Durum</th>
                    @if (isSystemAdmin)
                    {
                        <th scope="col">İşlemler</th>
                    }
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

@if (isSystemAdmin)
{
    <form id="teacherDeleteAntiforgeryForm" class="d-none" aria-hidden="true">
        @Html.AntiForgeryToken()
    </form>
}

@section Scripts
{
    <script src="~/js/pages/teachers-page.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
