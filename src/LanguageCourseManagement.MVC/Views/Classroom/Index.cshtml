@model LanguageCourseManagement.MVC.Models.ViewModels.ClassroomFormViewModel
@{
    ViewData["Title"] = "Derslikler";
    var isSystemAdmin = User.IsInRole("SystemAdmin");
}

<section class="content-card"
         id="classrooms-page"
         data-can-edit="@(isSystemAdmin.ToString().ToLowerInvariant())">
    <div class="section-heading">
        <div>
            <h1>Derslikler</h1>
            <p>Şubelere bağlı derslik ve kapasite yönetimi</p>
        </div>

        @if (isSystemAdmin)
        {
            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#classroomCreateModal">
                Yeni derslik
            </button>
        }
    </div>

    <div class="table-responsive">
        <table class="table" id="classroomsTable" data-datatable>
            <caption class="visually-hidden">Derslik listesi</caption>
            <thead>
                <tr>
                    <th scope="col">Şube</th>
                    <th scope="col">Derslik</th>
                    <th scope="col">Kapasite</th>
                    <th scope="col">Durum</th>
                    @if (isSystemAdmin)
                    {
                        <th scope="col">İşlemler</th>
                    }
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

@if (isSystemAdmin)
{
    <div class="modal fade"
         id="classroomCreateModal"
         tabindex="-1"
         aria-labelledby="classroomCreateModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="classroomCreateModalLabel">Yeni derslik</h2>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    @{
                        ViewData["FormAction"] = "Create";
                        ViewData["FormHeading"] = "";
                        ViewData["FormDescription"] = "Derslik bilgilerini girin.";
                        ViewData["SubmitText"] = "Kaydet";
                        ViewData["IsModal"] = true;
                    }
                    <partial name="_Form" model="Model" view-data="ViewData" />
                </div>
            </div>
        </div>
    </div>

    <form id="classroomDeleteAntiforgeryForm" class="d-none" aria-hidden="true">
        @Html.AntiForgeryToken()
    </form>
}

@section Scripts
{
    <script src="~/js/pages/classrooms-page.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}