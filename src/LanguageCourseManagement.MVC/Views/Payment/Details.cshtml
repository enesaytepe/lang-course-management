@model LanguageCourseManagement.MVC.Models.ViewModels.PaymentDetailsViewModel
@{
    ViewData["Title"] = "Tahsilat detayı";
}

<section class="content-card">
    <div class="section-heading">
        <div>
            <h1>Tahsilat detayı</h1>
            <p>Tahsilat bilgileri</p>
        </div>
    </div>

    <dl class="detail-list">
        <div>
            <dt>Tahsilat numarası</dt>
            <dd>@Model.Id</dd>
        </div>
        <div>
            <dt>Kayıt numarası</dt>
            <dd>
                <a href="/Enrollment/Details/@Model.EnrollmentId">@Model.EnrollmentId</a>
            </dd>
        </div>
        <div>
            <dt>Öğrenci</dt>
            <dd>@Model.StudentName</dd>
        </div>
        <div>
            <dt>Ders</dt>
            <dd>@Model.CourseName</dd>
        </div>
        <div>
            <dt>Şube</dt>
            <dd>@Model.BranchName</dd>
        </div>
        <div>
            <dt>Tutar</dt>
            <dd>@Model.Amount.ToString("N2") ₺</dd>
        </div>
        <div>
            <dt>Yöntem</dt>
            <dd>@Model.Method</dd>
        </div>
        <div>
            <dt>Durum</dt>
            <dd>
                <span class="status-pill @(Model.Status == "Settled" ? "status-active" : string.Empty)">
                    @(Model.Status == "Settled" ? "Tamamlandı" : Model.Status)
                </span>
            </dd>
        </div>
        <div>
            <dt>Tahsilat tarihi</dt>
            <dd>@Model.SettledAt.ToString("dd.MM.yyyy HH:mm")</dd>
        </div>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div>
                <dt>Açıklama</dt>
                <dd>@Model.Description</dd>
            </div>
        }
    </dl>

    <div class="form-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">Listeye dön</a>
    </div>
</section>
