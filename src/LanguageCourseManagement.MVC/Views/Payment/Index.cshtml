@{
    ViewData["Title"] = "Tahsilatlar";
    var isSystemAdmin = User.IsInRole("SystemAdmin");
}

<section class="content-card" id="payments-page" data-can-edit="@(isSystemAdmin.ToString().ToLowerInvariant())">
    <div class="section-heading">
        <div>
            <h1>Tahsilatlar</h1>
            <p>Nakit tahsilat yönetimi</p>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="branchFilter">Şube filtresi</label>
        <select class="form-select" id="branchFilter" style="max-width: 300px;">
            <option value="">Tüm Şubeler</option>
        </select>
    </div>

    <div class="table-responsive">
        <table class="table" id="paymentsTable" data-datatable>
            <caption class="visually-hidden">Tahsilat listesi</caption>
            <thead>
                <tr>
                    <th scope="col">Öğrenci</th>
                    <th scope="col">Ders</th>
                    <th scope="col">Şube</th>
                    <th scope="col">Tutar</th>
                    <th scope="col">Yöntem</th>
                    <th scope="col">Taksit</th>
                    <th scope="col">Durum</th>
                    <th scope="col">Tarih</th>
                    <th scope="col">İşlemler</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script src="~/js/pages/payments-page.js" asp-append-version="true"></script>
}
