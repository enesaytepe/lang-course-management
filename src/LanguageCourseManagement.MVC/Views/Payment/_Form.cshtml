@model LanguageCourseManagement.MVC.Models.ViewModels.PaymentFormViewModel
@{
    var heading = "Yeni Tahsilat";
    var description = "Tahsilat gerçekleştirin.";
}

<section class="content-card">
    <div class="section-heading">
        <div>
            <h1>@heading</h1>
            <p>@description</p>
        </div>
    </div>

    <form id="paymentForm" data-payment-form>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" data-validation-summary></div>

        <div class="row g-4">
            <div class="col-12">
                <label asp-for="EnrollmentId" class="form-label">Kayıt</label>
                <select asp-for="EnrollmentId" class="form-select" id="enrollmentSelect"
                        asp-items="@(new SelectList(Model.UnsettledEnrollments, "Id", "StudentName"))">
                    <option value="">-- Kayıt seçin --</option>
                </select>
                <span asp-validation-for="EnrollmentId" class="text-danger"></span>
            </div>

            <div class="col-12" id="enrollmentInfo" style="display:none;">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5 class="card-title">Seçilen Kayıt Bilgileri</h5>
                        <dl class="row mb-0">
                            <dt class="col-sm-3">Öğrenci</dt>
                            <dd class="col-sm-9" id="infoStudentName">-</dd>
                            <dt class="col-sm-3">Ders</dt>
                            <dd class="col-sm-9" id="infoCourseName">-</dd>
                            <dt class="col-sm-3">Şube</dt>
                            <dd class="col-sm-9" id="infoBranchName">-</dd>
                            <dt class="col-sm-3">Ödeme türü</dt>
                            <dd class="col-sm-9" id="infoPaymentType">-</dd>
                            <dt class="col-sm-3">Tahsilat tutarı</dt>
                            <dd class="col-sm-9"><strong id="infoFinalAmount">-</strong></dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="col-12" id="installmentSection" style="display:none;">
                <label class="form-label">Taksit seçin</label>
                <select class="form-select" id="installmentSelect">
                    <option value="">-- Taksit seçin --</option>
                </select>
                <span class="text-danger" id="installmentError"></span>
                <div id="installmentInfo" class="mt-2" style="display:none;">
                    <div class="card bg-light">
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-3">Taksit</dt>
                                <dd class="col-sm-9" id="infoInstallmentNumber">-</dd>
                                <dt class="col-sm-3">Tutar</dt>
                                <dd class="col-sm-9" id="infoInstallmentAmount">-</dd>
                                <dt class="col-sm-3">Vade</dt>
                                <dd class="col-sm-9" id="infoInstallmentDueDate">-</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <label asp-for="Method" class="form-label">Ödeme yöntemi</label>
                <select asp-for="Method" class="form-select" id="paymentMethod">
                    <option value="Cash">Nakit</option>
                    <option value="CreditCard">Kredi Kartı</option>
                    <option value="BankTransfer">Banka Havalesi</option>
                </select>
                <span asp-validation-for="Method" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label">Açıklama (isteğe bağlı)</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Tahsilat açıklaması girin..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary" id="submitBtn" disabled>Tahsilat Yap</button>
            <a class="btn btn-outline-secondary ms-2" asp-action="Index">İptal</a>
        </div>
    </form>
</section>

<script>
    $(function () {
        var enrollmentData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.UnsettledEnrollments.Select(e => new {
                id = e.Id,
                studentName = e.StudentName,
                courseName = e.CourseName,
                branchName = e.BranchName,
                finalAmount = e.FinalAmount,
                paymentType = e.PaymentType
            })));

        var installmentData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.EnrollmentInstallments.ToDictionary(
                kvp => kvp.Key.ToString(),
                kvp => kvp.Value.Select(i => new {
                    id = i.Id,
                    installmentNumber = i.InstallmentNumber,
                    amount = i.Amount,
                    dueDate = i.DueDate,
                    status = i.Status
                }))));
        installmentData = installmentData || {};

        var $select = $('#enrollmentSelect');
        var $info = $('#enrollmentInfo');
        var $submitBtn = $('#submitBtn');
        var $installmentSection = $('#installmentSection');
        var $installmentSelect = $('#installmentSelect');
        var $installmentInfo = $('#installmentInfo');

        function formatCurrency(value) {
            return new Intl.NumberFormat('tr-TR', { style: 'decimal', minimumFractionDigits: 2 }).format(value) + ' ₺';
        }

        function updateEnrollmentInfo() {
            var selectedId = $select.val();
            if (!selectedId) {
                $info.hide();
                $installmentSection.hide();
                $submitBtn.prop('disabled', true);
                return;
            }

            var enrollment = enrollmentData.find(function (e) { return e.id === selectedId; });
            if (enrollment) {
                $('#infoStudentName').text(enrollment.studentName);
                $('#infoCourseName').text(enrollment.courseName);
                $('#infoBranchName').text(enrollment.branchName || '-');
                $('#infoPaymentType').text(enrollment.paymentType === 'Installment' ? 'Taksitli' : 'Nakit');
                $('#infoFinalAmount').text(formatCurrency(enrollment.finalAmount));
                $info.show();

                if (enrollment.paymentType === 'Installment') {
                    var installments = installmentData[selectedId] || [];
                    $installmentSelect.find('option:gt(0)').remove();
                    $.each(installments, function (_, inst) {
                        $installmentSelect.append($('<option>', {
                            value: inst.id,
                            text: '#' + inst.installmentNumber + ' - ' + formatCurrency(inst.amount) + ' (Vade: ' + inst.dueDate + ')'
                        }));
                    });
                    $installmentSection.show();
                    $installmentInfo.hide();
                    $submitBtn.prop('disabled', true);
                } else {
                    $installmentSection.hide();
                    $submitBtn.prop('disabled', false);
                }
            }
        }

        $select.on('change', updateEnrollmentInfo);

        $installmentSelect.on('change', function () {
            var selectedId = $select.val();
            var installmentId = $(this).val();
            if (!installmentId) {
                $installmentInfo.hide();
                $submitBtn.prop('disabled', true);
                return;
            }

            var installments = installmentData[selectedId] || [];
            var inst = installments.find(function (i) { return i.id === installmentId; });
            if (inst) {
                $('#infoInstallmentNumber').text(inst.installmentNumber + '. taksit');
                $('#infoInstallmentAmount').text(formatCurrency(inst.amount));
                $('#infoInstallmentDueDate').text(inst.dueDate);
                $installmentInfo.show();
                $submitBtn.prop('disabled', false);
            }
        });

        updateEnrollmentInfo();

        // Form submit via AJAX
        $('#paymentForm').on('submit', function (event) {
            event.preventDefault();
            var form = $(this);
            var token = form.find('input[name="__RequestVerificationToken"]').val();
            var enrollmentId = $select.val();

            if (!enrollmentId) {
                Swal.fire('Uyarı', 'Lütfen bir kayıt seçin.', 'warning');
                return;
            }

            var enrollment = enrollmentData.find(function (e) { return e.id === enrollmentId; });
            var payload = {
                enrollmentId: enrollmentId,
                method: $('#paymentMethod').val() || 'Cash',
                description: $('#Description').val() || ''
            };

            if (enrollment && enrollment.paymentType === 'Installment') {
                var installmentId = $installmentSelect.val();
                if (!installmentId) {
                    Swal.fire('Uyarı', 'Lütfen bir taksit seçin.', 'warning');
                    return;
                }
                payload.installmentId = installmentId;
            }

            $submitBtn.prop('disabled', true).text('İşleniyor...');

            $.ajax({
                url: '/api/payments',
                method: 'POST',
                contentType: 'application/json',
                headers: { 'X-XSRF-TOKEN': token },
                data: JSON.stringify(payload)
            }).done(function (data) {
                Swal.fire({
                    title: 'Başarılı',
                    text: 'Tahsilat başarıyla gerçekleştirildi.',
                    icon: 'success'
                }).then(function () {
                    window.location.href = '/Payment/Details/' + data.id;
                });
            }).fail(function (xhr) {
                var message = 'Tahsilat gerçekleştirilemedi.';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                } else if (xhr.responseJSON && xhr.responseJSON.errors) {
                    message = Object.values(xhr.responseJSON.errors).flat().join('\n');
                }
                Swal.fire('Hata', message, 'error');
                $submitBtn.prop('disabled', false).text('Tahsilat Yap');
            });
        });
    });
</script>
