@model LanguageCourseManagement.MVC.Models.ViewModels.CourseFormViewModel
@{ var action = ViewData["FormAction"] as string ?? "Create"; var edit = action == "Edit"; }
<section class="content-card"><div class="section-heading"><div><h1>@ViewData["FormHeading"]</h1><p>@ViewData["FormDescription"]</p></div></div>
<form asp-action="@action" asp-route-id="@(edit ? Model.Id : null)" method="post" asp-antiforgery="true" data-course-form="@(edit ? "update" : "create")" data-course-id="@(edit ? Model.Id : null)"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="BranchId" class="form-label"></label><select asp-for="BranchId" class="form-select"><option value="">Şube seçin</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select><span asp-validation-for="BranchId" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="OfferedLanguageId" class="form-label"></label><select asp-for="OfferedLanguageId" class="form-select"><option value="">Dil seçin</option>@foreach(var x in Model.Languages){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-4"><label asp-for="CourseLevelId" class="form-label"></label><select asp-for="CourseLevelId" class="form-select"><option value="">Seviye seçin</option>@foreach(var x in Model.Levels){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LanguageCourseManagement.Domain.Enums.CourseStatus>()"></select></div>
<div class="col-md-6"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date" class="form-control" /></div><div class="col-md-6"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date" class="form-control" /></div>
<div class="col-12"><h2 class="h5">Haftalık program</h2><div id="courseSchedules">@for(var i=0;i<Model.Schedules.Count;i++){<div class="row g-2 mb-2 schedule-row"><div class="col-md-4"><select name="Schedules[@i].DayOfWeek" class="form-select"><!option value="1" @(Model.Schedules[i].DayOfWeek == DayOfWeek.Monday ? "selected" : null)>Pazartesi</!option><!option value="2" @(Model.Schedules[i].DayOfWeek == DayOfWeek.Tuesday ? "selected" : null)>Salı</!option><!option value="3" @(Model.Schedules[i].DayOfWeek == DayOfWeek.Wednesday ? "selected" : null)>Çarşamba</!option><!option value="4" @(Model.Schedules[i].DayOfWeek == DayOfWeek.Thursday ? "selected" : null)>Perşembe</!option><!option value="5" @(Model.Schedules[i].DayOfWeek == DayOfWeek.Friday ? "selected" : null)>Cuma</!option><!option value="6" @(Model.Schedules[i].DayOfWeek == DayOfWeek.Saturday ? "selected" : null)>Cumartesi</!option><!option value="0" @(Model.Schedules[i].DayOfWeek == DayOfWeek.Sunday ? "selected" : null)>Pazar</!option></select></div><div class="col-md-3"><input name="Schedules[@i].StartTime" value="@Model.Schedules[i].StartTime" type="time" class="form-control" /></div><div class="col-md-3"><input name="Schedules[@i].EndTime" value="@Model.Schedules[i].EndTime" type="time" class="form-control" /></div><div class="col-md-2"><button type="button" class="btn btn-outline-danger remove-schedule">Kaldır</button></div></div>}</div><button type="button" class="btn btn-outline-secondary" id="addSchedule">Gün ekle</button></div>
<div class="col-md-6"><label asp-for="TeacherId" class="form-label"></label><select asp-for="TeacherId" class="form-select" id="TeacherId"><option value="">Önce program seçin</option>@foreach(var x in Model.EligibleTeachers){<option value="@x.Id">@x.FullName</option>}</select></div><div class="col-md-6"><label asp-for="ClassroomId" class="form-label"></label><select asp-for="ClassroomId" class="form-select" id="ClassroomId"><option value="">Önce program seçin</option>@foreach(var x in Model.EligibleClassrooms){<option value="@x.Id">@x.Name (@x.Capacity)</option>}</select></div>
<div class="col-md-6"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" type="number" min="1" class="form-control" /></div><div class="col-md-6"><label asp-for="TuitionFee" class="form-label"></label><input asp-for="TuitionFee" type="number" min="0" step="0.01" class="form-control" /></div>@if(edit){<div class="col-12 form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Aktif</label></div>}</div>
<div class="form-actions"><a class="btn btn-outline-secondary" asp-action="@(edit ? "Details" : "Index")" asp-route-id="@(edit ? Model.Id : null)">Vazgeç</a><button type="submit" class="btn btn-primary">@ViewData["SubmitText"]</button></div></form></section>
