@model LanguageCourseManagement.MVC.Models.ViewModels.CourseDetailsViewModel
@{ ViewData["Title"] = "Ders Detayı"; var admin = User.IsInRole("SystemAdmin"); }
<section class="content-card"><div class="section-heading"><div><h1>@Model.Name</h1><p>@Model.LanguageName / @Model.LevelName</p></div>@if(admin){<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>}</div>
<dl class="row"><dt class="col-sm-3">Şube</dt><dd class="col-sm-9">@Model.BranchName</dd><dt class="col-sm-3">Öğretmen</dt><dd class="col-sm-9">@Model.TeacherName</dd><dt class="col-sm-3">Derslik</dt><dd class="col-sm-9">@Model.ClassroomName</dd><dt class="col-sm-3">Tarih</dt><dd class="col-sm-9">@Model.StartDate - @Model.EndDate</dd><dt class="col-sm-3">Kontenjan</dt><dd class="col-sm-9">@Model.Capacity</dd><dt class="col-sm-3">Ücret</dt><dd class="col-sm-9">@Model.TuitionFee.ToString("N2") ₺</dd><dt class="col-sm-3">Durum</dt><dd class="col-sm-9">@Model.Status</dd></dl>
<h2 class="h5 mt-4">Haftalık program</h2><div class="table-responsive"><table class="table"><thead><tr><th>Gün</th><th>Başlangıç</th><th>Bitiş</th></tr></thead><tbody>@foreach(var schedule in Model.Schedules){<tr><td>@schedule.DayOfWeek</td><td>@schedule.StartTime</td><td>@schedule.EndTime</td></tr>}</tbody></table></div><a class="btn btn-outline-secondary" asp-action="Index">Derslere dön</a></section>
