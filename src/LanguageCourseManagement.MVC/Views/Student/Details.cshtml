@model LanguageCourseManagement.MVC.Models.ViewModels.StudentDetailsViewModel
@{
    ViewData["Title"] = Model.FirstName + " " + Model.LastName;
}

<section class="content-card">
    <div class="section-heading">
        <div>
            <h1>@Model.FirstName @Model.LastName</h1>
            <p>Öğrenci detayı</p>
        </div>
        @if (User.IsInRole("SystemAdmin"))
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
        }
    </div>

    <dl class="detail-list">
        <div><dt>Ad</dt><dd>@Model.FirstName</dd></div>
        <div><dt>Soyad</dt><dd>@Model.LastName</dd></div>
        <div><dt>Ev telefonu</dt><dd>@(Model.HomePhone ?? "-")</dd></div>
        <div><dt>Cep telefonu</dt><dd>@Model.MobilePhone</dd></div>
        <div><dt>E-posta</dt><dd>@(Model.Email ?? "-")</dd></div>
        <div><dt>Adres</dt><dd>@(Model.Address ?? "-")</dd></div>
        <div><dt>Kayıt tarihi</dt><dd>@Model.RegistrationDate.ToString("dd.MM.yyyy")</dd></div>
        <div><dt>Durum</dt><dd><span class="status-pill @(Model.IsActive ? "status-active" : string.Empty)">@(Model.IsActive ? "Aktif" : "Pasif")</span></dd></div>
    </dl>

    <div class="form-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">Listeye dön</a>
    </div>
</section>

<section class="content-card" style="margin-top: 1.5rem;">
    <div class="section-heading">
        <div>
            <h2>Kayıt Geçmişi</h2>
            <p>Bu öğrenciye ait tüm kurs kayıtları</p>
        </div>
    </div>

    @if (Model.Enrollments.Count == 0)
    {
        <p class="text-muted">Henüz bir kurs kaydı bulunmuyor.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Ders</th>
                        <th>Kayıt Tarihi</th>
                        <th>Ücret</th>
                        <th>İndirim</th>
                        <th>Ödeme Türü</th>
                        <th>Durum</th>
                        <th>Tahsilat</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrollment in Model.Enrollments)
                    {
                        <tr>
                            <td>@enrollment.CourseName</td>
                            <td>-</td>
                            <td>@enrollment.FinalAmount.ToString("C")</td>
                            <td>-</td>
                            <td>@enrollment.PaymentType</td>
                            <td><span class="status-pill @(enrollment.Status == "Active" ? "status-active" : string.Empty)">@enrollment.Status</span></td>
                            <td><span class="status-pill @(enrollment.IsSettled ? "status-active" : string.Empty)">@(enrollment.IsSettled ? "Tamamlandı" : "Bekliyor")</span></td>
                            <td><a asp-controller="Enrollment" asp-action="Details" asp-route-id="@enrollment.Id" class="btn btn-sm btn-outline-secondary">Detay</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="content-card" style="margin-top: 1.5rem;">
    <div class="section-heading">
        <div>
            <h2>Ödeme Geçmişi</h2>
            <p>Bu öğrenciye ait tüm tahsilatlar</p>
        </div>
    </div>

    @if (Model.PaymentHistory.Count == 0)
    {
        <p class="text-muted">Henüz bir tahsilat bulunmuyor.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Ders</th>
                        <th>Tutar</th>
                        <th>Yöntem</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.PaymentHistory)
                    {
                        <tr>
                            <td>@payment.CourseName</td>
                            <td>@payment.Amount.ToString("C")</td>
                            <td>@payment.Method</td>
                            <td>@payment.PaymentDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td><span class="status-pill @(payment.Status == "Settled" ? "status-active" : string.Empty)">@payment.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
