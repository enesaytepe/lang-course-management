@model LanguageCourseManagement.MVC.Models.ViewModels.StudentDetailsViewModel
@{
    ViewData["Title"] = Model.FirstName + " " + Model.LastName;
}

<section class="content-card">
    <div class="section-heading">
        <div>
            <h1>@Model.FirstName @Model.LastName</h1>
            <p>Öğrenci detayı</p>
        </div>
        @if (User.IsInRole("SystemAdmin"))
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
        }
    </div>

    <dl class="detail-list">
        <div><dt>Ad</dt><dd>@Model.FirstName</dd></div>
        <div><dt>Soyad</dt><dd>@Model.LastName</dd></div>
        <div><dt>Ev telefonu</dt><dd>@(Model.HomePhone ?? "-")</dd></div>
        <div><dt>Cep telefonu</dt><dd>@Model.MobilePhone</dd></div>
        <div><dt>E-posta</dt><dd>@(Model.Email ?? "-")</dd></div>
        <div><dt>Kayıt tarihi</dt><dd>@Model.RegistrationDate.ToString("dd.MM.yyyy")</dd></div>
        <div><dt>Durum</dt><dd><span class="status-pill @(Model.IsActive ? "status-active" : string.Empty)">@(Model.IsActive ? "Aktif" : "Pasif")</span></dd></div>
    </dl>

    <div class="form-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">Listeye dön</a>
    </div>
</section>
