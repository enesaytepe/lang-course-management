@model LanguageCourseManagement.MVC.Models.ViewModels.LanguageFormViewModel
@{ var formAction = ViewData["FormAction"] as string ?? "Create"; var isEdit = formAction == "Edit"; var isModal = ViewData["IsModal"] as bool? ?? false; var heading = ViewData["FormHeading"] as string ?? "Yeni dil"; var description = ViewData["FormDescription"] as string ?? "Dil bilgilerini girin."; var cancelAction = ViewData["CancelAction"] as string ?? "Index"; var submitText = ViewData["SubmitText"] as string ?? "Kaydet"; }
<section class="content-card @(isModal ? "border-0 shadow-none p-0" : "")">@if (!isModal) { <div class="section-heading"><div><h1>@heading</h1><p>@description</p></div></div> }<form id="@(isModal ? "languageCreateForm" : null)" asp-action="@formAction" asp-route-id="@(isEdit ? Model.Id : null)" method="post" asp-antiforgery="@(!isModal)" data-language-create-form="@(isModal ? "true" : null)" data-language-form="@(isModal ? null : (isEdit ? "update" : "create"))" data-language-id="@(isEdit ? Model.Id : null)"><div asp-validation-summary="ModelOnly" class="text-danger mb-3" data-validation-summary></div><div class="row g-4"><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger"></span></div>@if (isEdit) { <div class="col-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Aktif</label></div></div> }</div><div class="form-actions">@if (isModal) { <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button> } else { <a class="btn btn-outline-secondary" asp-action="@cancelAction" asp-route-id="@(isEdit ? Model.Id : null)">Vazgeç</a> }<button type="submit" class="btn btn-primary">@submitText</button></div></form></section>
