@model LanguageCourseManagement.Application.DTOs.OfferedLanguages.OfferedLanguageResponse
@{ ViewData["Title"] = Model.Name; }
<section class="content-card"><div class="section-heading"><div><h1>@Model.Name</h1><p>Dil detayı</p></div>@if (User.IsInRole("SystemAdmin")) { <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a> }</div>
<dl class="detail-list"><div><dt>Dil adı</dt><dd>@Model.Name</dd></div><div><dt>Kod</dt><dd>@(Model.Code ?? "-")</dd></div><div><dt>Durum</dt><dd><span class="status-pill @(Model.IsActive ? "status-active" : "")">@(Model.IsActive ? "Aktif" : "Pasif")</span></dd></div></dl><div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">Dillere dön</a></div></section>
