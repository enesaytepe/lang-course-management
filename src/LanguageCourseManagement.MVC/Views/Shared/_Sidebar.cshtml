@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isSystemAdmin = User.IsInRole("SystemAdmin");
    var navigation = new List<(string Controller, string Action, string Label, bool AdminOnly)>
    {
        ("Dashboard", "Index", "Yönetim Panosu", false),
        ("Branch", "Index", "Şubeler", false),
        ("Classroom", "Index", "Derslikler", false),
        ("Facility", "Index", "Tesisler", false),
        ("Language", "Index", "Diller", false),
        ("CourseLevel", "Index", "Kurs Seviyeleri", false),
        ("Teacher", "Index", "Öğretmenler", false),
        ("Student", "Index", "Öğrenciler", false),
        ("Course", "Index", "Dersler", false),
        ("Enrollment", "Index", "Kayıtlar", false),
        ("Payment", "Index", "Tahsilatlar", false),
        ("User", "Index", "Kullanıcılar", true)
    };
}
<aside class="sidebar" aria-label="Ana menü">
    <a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark" aria-hidden="true">BL</span><span>Bir Lisan<br /><strong>Bir İnsan</strong></span></a>
    <p class="sidebar-caption">Yönetim</p>
    <nav>
        <ul class="nav flex-column gap-1">
            @foreach (var item in navigation)
            {
                if (item.AdminOnly && !isSystemAdmin) continue;
                var isActive = controller == item.Controller;
                <li>
                    <a class="side-link @(isActive ? "active" : string.Empty)" asp-controller="@item.Controller" asp-action="@item.Action" aria-current="@(isActive ? "page" : null)"><span aria-hidden="true">›</span>@item.Label</a>
                </li>
            }
        </ul>
    </nav>
    <div class="role-summary" aria-label="Kullanıcı rolü"><span>Oturum açıldı</span><strong>@User.Identity?.Name</strong><small>@(User.IsInRole("SystemAdmin") ? "SystemAdmin" : "RegistrationOfficer")</small></div>
</aside>
