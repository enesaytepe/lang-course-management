@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<section class="content-card">
    <h1 class="text-danger">Bir hata oluştu</h1>
    <p>İsteğiniz işlenirken beklenmeyen bir sorun oluştu. Lütfen daha sonra tekrar deneyin.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small mb-0">Destek referansı: <code>@Model.RequestId</code></p>
    }
</section>
