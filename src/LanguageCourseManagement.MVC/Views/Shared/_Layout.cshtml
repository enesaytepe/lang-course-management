<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bir Lisan Bir İnsan</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LanguageCourseManagement.MVC.styles.css" asp-append-version="true" />
</head>

<body>
    <a class="skip-link" href="#main-content">Ana içeriğe geç</a>
    <div class="app-shell">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <partial name="_Sidebar" />
        }
        <div class="app-content">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <partial name="_Topbar" view-data="@ViewData" />
            }
            <main id="main-content" role="main" class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/sweetalert2/dist/sweetalert2.min.js"></script>
    <script src="~/js/core/common.js" asp-append-version="true"></script>
    <script src="~/js/branch-selector.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>

</html>
