@model LanguageCourseManagement.MVC.Models.ViewModels.CourseLevelFormViewModel
@{
    ViewData["Title"] = "Kurs Seviyeleri";
    var isSystemAdmin = User.IsInRole("SystemAdmin");
}

<section class="content-card" id="course-levels-page" data-can-edit="@(isSystemAdmin.ToString().ToLowerInvariant())">
    <div class="section-heading">
        <div><h1>Kurs Seviyeleri</h1><p>Seviye yönetimi</p></div>
        @if (isSystemAdmin)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#courseLevelCreateModal">Yeni seviye</button>
        }
    </div>
    <div class="mb-3">
        <label for="courseLevelLanguageFilter" class="form-label">Dil filtresi</label>
        <select id="courseLevelLanguageFilter" class="form-select">
            <option value="">Tüm diller</option>
            @foreach (var language in Model.Languages)
            {
                <option value="@language.Id">@language.Name@(!language.IsActive ? " (Pasif)" : string.Empty)</option>
            }
        </select>
    </div>
    <div class="table-responsive">
        <table class="table" id="course-levelsTable" data-datatable>
            <caption class="visually-hidden">Kurs seviyesi listesi</caption>
            <thead><tr><th scope="col">Dil</th><th scope="col">Seviye adı</th><th scope="col">Sıra</th><th scope="col">Durum</th>@if (isSystemAdmin) { <th scope="col">İşlemler</th> }</tr></thead>
            <tbody></tbody>
        </table>
    </div>
</section>

@if (isSystemAdmin)
{
    <div class="modal fade" id="courseLevelCreateModal" tabindex="-1" aria-labelledby="courseLevelCreateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><div class="modal-header">
            <h2 class="modal-title fs-5" id="courseLevelCreateModalLabel">Yeni seviye</h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
        </div><div class="modal-body">
            @{ ViewData["FormAction"] = "Create"; ViewData["FormHeading"] = ""; ViewData["FormDescription"] = "Kurs seviyesi bilgilerini girin."; ViewData["SubmitText"] = "Kaydet"; ViewData["IsModal"] = true; }
            <partial name="_Form" model="Model" view-data="ViewData" />
        </div></div></div>
    </div>
    <form id="courseLevelDeleteAntiforgeryForm" class="d-none" aria-hidden="true">@Html.AntiForgeryToken()</form>
}

@section Scripts { <script src="~/js/pages/course-levels-page.js" asp-append-version="true"></script><partial name="_ValidationScriptsPartial" /> }
