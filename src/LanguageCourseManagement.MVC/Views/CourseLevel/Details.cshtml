@model LanguageCourseManagement.Application.DTOs.CourseLevels.CourseLevelResponse
@{ ViewData["Title"] = "Kurs Seviyesi Detayı"; var isSystemAdmin = User.IsInRole("SystemAdmin"); }
<section class="content-card"><div class="section-heading"><div><h1>@Model.Name</h1><p>@Model.LanguageName kurs seviyesi</p></div>@if (isSystemAdmin) { <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a> }</div>
<dl class="row mb-0"><dt class="col-sm-3">Dil</dt><dd class="col-sm-9">@Model.LanguageName</dd><dt class="col-sm-3">Seviye adı</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Açıklama</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd><dt class="col-sm-3">Sıra</dt><dd class="col-sm-9">@Model.Order</dd><dt class="col-sm-3">Durum</dt><dd class="col-sm-9">@(Model.IsActive ? "Aktif" : "Pasif")</dd></dl>
<div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">Seviyelere dön</a></div></section>
