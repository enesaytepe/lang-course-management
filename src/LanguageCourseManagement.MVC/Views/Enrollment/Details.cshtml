@model LanguageCourseManagement.MVC.Models.ViewModels.EnrollmentDetailViewModel
@{
    ViewData["Title"] = "Kayıt detayı";
    var isSystemAdmin = User.IsInRole("SystemAdmin");
}

<form id="installmentAntiForgeryTokenForm" style="display:none;">@Html.AntiForgeryToken()</form>

<section class="content-card">
    <div class="section-heading">
        <div>
            <h1>Kayıt detayı</h1>
            <p>Öğrenci kayıt ve tahsilat bilgileri</p>
        </div>
        <div class="table-actions">
            @if (isSystemAdmin && Model.Status == "Active")
            {
                <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Durumu düzenle</a>
            }
            <a class="btn btn-outline-secondary" asp-action="Index">Listeye dön</a>
        </div>
    </div>

    <dl class="detail-list">
        <div>
            <dt>Öğrenci</dt>
            <dd>@Model.StudentName</dd>
        </div>
        <div>
            <dt>Ders</dt>
            <dd>@Model.CourseName</dd>
        </div>
        <div>
            <dt>Kurs ücreti</dt>
            <dd>@Model.TuitionFee.ToString("N2") ₺</dd>
        </div>
        <div>
            <dt>İndirim</dt>
            <dd>@Model.DiscountAmount.ToString("N2") ₺</dd>
        </div>
        <div>
            <dt>Son tutar</dt>
            <dd>@Model.FinalAmount.ToString("N2") ₺</dd>
        </div>
        <div>
            <dt>Ödeme türü</dt>
            <dd>@(Model.PaymentType == "Installment" ? "Taksitli" : "Nakit")</dd>
        </div>
        <div>
            <dt>Durum</dt>
            <dd>
                <span class="status-pill @(Model.Status == "Active" ? "status-active" : string.Empty)">
                    @(Model.Status == "Completed" ? "Tamamlandı" : Model.Status == "Cancelled" ? "İptal edildi" : "Aktif")
                </span>
            </dd>
        </div>
        <div>
            <dt>Tahsilat</dt>
            <dd>@(Model.IsSettled ? "Tamamlandı" : "Bekliyor")</dd>
        </div>
        @if (Model.PaymentId.HasValue)
        {
            <div>
                <dt>Tahsilat numarası</dt>
                <dd>@Model.PaymentId</dd>
            </div>
        }
    </dl>

    @if (isSystemAdmin && Model.Status == "Active" && Model.PaymentType == "Installment")
    {
        <div class="card mt-3">
            <div class="card-header">
                <h5 class="mb-0">Taksit Planı</h5>
            </div>
            <div class="card-body">
                @if (Model.Installments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Taksit</th>
                                    <th>Tutar</th>
                                    <th>Vade</th>
                                    <th>Durum</th>
                                    <th>Ödenen</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var installment in Model.Installments)
                                {
                                    <tr>
                                        <td>@installment.InstallmentNumber</td>
                                        <td>@installment.Amount.ToString("N2") ₺</td>
                                        <td>@installment.DueDate.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            <span class="status-pill @(installment.IsPaid ? "status-active" : string.Empty)">
                                                @(installment.Status == "Settled" ? "Ödendi" : installment.Status == "Overdue" ? "Vadesi geçti" : installment.Status == "Cancelled" ? "İptal" : "Bekliyor")
                                            </span>
                                        </td>
                                        <td>@installment.PaidAmount.ToString("N2") ₺</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="row align-items-end">
                        <div class="col-md-4">
                            <label for="installmentCount" class="form-label">Taksit Sayısı</label>
                            <select id="installmentCount" class="form-select">
                                <option value="2">2 Taksit</option>
                                <option value="3">3 Taksit</option>
                                <option value="4">4 Taksit</option>
                                <option value="6">6 Taksit</option>
                                <option value="9">9 Taksit</option>
                                <option value="12">12 Taksit</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button id="btnCreateInstallmentPlan" class="btn btn-primary" data-enrollment-id="@Model.Id">
                                <i class="fas fa-plus"></i> Taksit Planı Oluştur
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (Model.Installments.Any())
    {
        <h5 class="mt-4 mb-3">Taksit Planı</h5>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Taksit</th>
                        <th>Tutar</th>
                        <th>Vade</th>
                        <th>Durum</th>
                        <th>Ödenen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var installment in Model.Installments)
                    {
                        <tr>
                            <td>@installment.InstallmentNumber</td>
                            <td>@installment.Amount.ToString("N2") ₺</td>
                            <td>@installment.DueDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span class="status-pill @(installment.IsPaid ? "status-active" : string.Empty)">
                                    @(installment.Status == "Settled" ? "Ödendi" : installment.Status == "Overdue" ? "Vadesi geçti" : installment.Status == "Cancelled" ? "İptal" : "Bekliyor")
                                </span>
                            </td>
                            <td>@installment.PaidAmount.ToString("N2") ₺</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script>
        (function ($) {
            'use strict';

            $('#btnCreateInstallmentPlan').on('click', function () {
                var btn = $(this);
                var enrollmentId = btn.data('enrollment-id');
                var installmentCount = $('#installmentCount').val();

                Swal.fire({
                    title: 'Taksit Planı Oluştur',
                    text: installmentCount + ' taksitli plan oluşturulacak. Emin misiniz?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Evet, oluştur',
                    cancelButtonText: 'İptal'
                }).then(function (result) {
                    if (!result.isConfirmed) {
                        return;
                    }

                    btn.prop('disabled', true);

                    $.ajax({
                        url: '/api/enrollments/' + encodeURIComponent(enrollmentId) + '/installments?installmentCount=' + installmentCount,
                        type: 'POST',
                        headers: {
                            'X-XSRF-TOKEN': $('#installmentAntiForgeryTokenForm input[name="__RequestVerificationToken"]').val()
                        }
                    })
                        .done(function () {
                            Swal.fire('Başarılı!', 'Taksit planı oluşturuldu.', 'success')
                                .then(function () {
                                    location.reload();
                                });
                        })
                        .fail(function (xhr) {
                            Swal.fire('Hata!', xhr.responseText || 'Taksit planı oluşturulamadı.', 'error');
                        })
                        .always(function () {
                            btn.prop('disabled', false);
                        });
                });
            });
        })(jQuery);
    </script>
}
