@model LanguageCourseManagement.MVC.Models.ViewModels.EnrollmentCreateViewModel

<form id="enrollmentCreateForm" data-enrollment-form="create" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdempotencyKey" />

    <div data-validation-summary class="validation-summary-valid text-danger" asp-validation-summary="All"></div>

    <div class="mb-3">
        <label class="form-label" for="StudentId">Öğrenci</label>
        <div class="input-group">
            <input type="text" class="form-control" id="StudentSearch" placeholder="Öğrenci ara..." autocomplete="off" />
            <button type="button" class="btn btn-outline-secondary" id="StudentSearchClear" title="Aramayı temizle">&times;</button>
        </div>
        <select class="form-select mt-1" asp-for="StudentId" id="StudentId" required size="1">
            <option value="">Öğrenci seçin</option>
        </select>
        <small class="text-muted" id="StudentCount"></small>
        <span class="text-danger" data-valmsg-for="StudentId"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" for="CourseId">Ders</label>
        <div class="input-group">
            <input type="text" class="form-control" id="CourseSearch" placeholder="Ders ara..." autocomplete="off" />
            <button type="button" class="btn btn-outline-secondary" id="CourseSearchClear" title="Aramayı temizle">&times;</button>
        </div>
        <select class="form-select mt-1" asp-for="CourseId" id="CourseId" required size="1">
            <option value="">Ders seçin</option>
        </select>
        <small class="text-muted" id="CourseCount"></small>
        <span class="text-danger" data-valmsg-for="CourseId"></span>
    </div>

    <div id="eligibilityInfo" class="mb-3" style="display:none;">
        <div class="alert" role="alert" id="eligibilityAlert"></div>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="DiscountAmount">İndirim tutarı</label>
        <input class="form-control" asp-for="DiscountAmount" min="0" step="0.01" />
        <span class="text-danger" data-valmsg-for="DiscountAmount"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="PaymentType">Ödeme türü</label>
        <select class="form-select" asp-for="PaymentType" id="PaymentType">
            <option value="Cash">Nakit (Tek seferde)</option>
            <option value="Installment">Taksitli ödeme</option>
        </select>
        <span class="text-danger" data-valmsg-for="PaymentType"></span>
    </div>

    <div class="form-actions">
        <button class="btn btn-primary" type="submit">@(ViewData["SubmitText"] ?? "Kaydet")</button>
        <a class="btn btn-outline-secondary" asp-controller="Enrollment" asp-action="Index">Vazgeç</a>
    </div>
</form>
